# PORT is provided by the hosting platform (Vercel/Railway/Render); no need to set it.
# CORS is open by default — no configuration required.

# ── Tier ─────────────────────────────────────────────────
# `development` (local machine) or `production` (Vercel). Leave it unset on
# Vercel — it is derived from VERCEL_ENV there, so the production deployment
# is the only context that gets the live tier. Anywhere else it defaults to
# `development`, so a forgotten value always lands on the safe tier.
# It is cross-checked against the Stripe key prefix at boot: sk_live_ under
# APP_ENV=development (or sk_test_ under production) fails the boot outright.
APP_ENV=development

# ── Supabase ────────────────────────────────────────────
# Project: trpluywvtaecvarrzugp
SUPABASE_URL=https://trpluywvtaecvarrzugp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# JWT secret used to verify Supabase-issued access tokens (Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=
# Storage bucket for all uploaded media
SUPABASE_STORAGE_BUCKET=media

# ── Google OAuth (mobile only) ──────────────────────────
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=

# ── Push notifications (Iteration 6) ────────────────────
# Firebase service account JSON (Android FCM) — either a path or inline JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# Expo / APNs (iOS)
EXPO_ACCESS_TOKEN=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=fr.lamenagereparis.app


# ── Sign in with Apple (token revocation on account deletion) ──
# Contents of the AuthKey_<KEY_ID>.p8 downloaded from developer.apple.com
# (Keys → Sign in with Apple). Newlines may be escaped as \n.
APPLE_SIGNIN_KEY_P8=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_TEAM_ID=W7WHZ6FD43
APPLE_SIGNIN_CLIENT_ID=com.progix.lamenagereparis

# Stripe (online payments). The prefix must match APP_ENV — sk_test_ for
# development, sk_live_ for production; the server refuses to boot otherwise.
STRIPE_SECRET_KEY=
# Locally: the secret `stripe listen --forward-to
# localhost:3333/payments/webhook` prints (tied to your Stripe CLI login).
# In production: the signing secret of the dashboard endpoint.
# The two are not interchangeable — an event signed by the wrong tier's secret
# is refused by its `livemode` flag before anything is applied.
STRIPE_WEBHOOK_SECRET=

# ── Invoice email (SMTP) ─────────────────────────────────
# REQUIRED in any environment that takes payments: every paid order's PDF
# facture is emailed to the customer automatically, and they are never given
# another way to ask for it. Left empty the PDF is still generated and stored,
# but nothing is delivered — the boot log says so, and each undelivered order
# gets `smtp_not_configured` written to `invoices.email_error`.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset.
SMTP_FROM=

# Questionnaire de cadrage web — clé de la console de consultation (/briefs?k=…)
BRIEF_OWNER_KEY=
