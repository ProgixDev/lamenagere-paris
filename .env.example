# ══════════════════════════════════════════════════════════════════════
#  Template for the DEVELOPMENT env — copy to `.env` and fill in.
#
#  It never reaches a build: `.env*` is excluded in .easignore, and EAS
#  builds/updates take their values from the EAS environment named by the
#  build profile in eas.json (development / preview / production).
#  So editing this file cannot change what production ships. To change
#  production, edit the EAS `production` environment — see ENVIRONMENTS.md.
# ══════════════════════════════════════════════════════════════════════

# Backend — the local NestJS server (`cd server && npm run start:dev`).
# - iOS Simulator: http://localhost:3333 (shares the Mac's network).
# - Android emulator: http://10.0.2.2:3333 (alias for the host machine).
# - Physical device: http://<your-mac-LAN-IP>:3333 on the SAME Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:3333

# Supabase — used by the app only to run the Google OAuth (PKCE) flow.
# Same project as production for now; dev writes to the production database,
# so treat what you create here as real. Stripe is what is isolated, not this.
EXPO_PUBLIC_SUPABASE_URL=https://trpluywvtaecvarrzugp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — TEST publishable key. Must be the test key of the same account the
# local server uses (Dashboard → "Test mode" ON → Developers → API keys):
# a pk_test_ against an sk_live_ server cannot confirm an intent, and vice versa.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
