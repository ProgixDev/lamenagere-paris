# EAS uses this INSTEAD of .gitignore to decide what to upload, so it must
# re-list the heavy dirs .gitignore normally excludes, plus extra junk that
# is committed/untracked but not needed to build the Expo app.

# Dependencies & caches (huge — must stay out)
node_modules/
.expo/
dist/
web-build/
.git/
.kotlin/
*.tsbuildinfo
.metro-health-check*

# Native folders — regenerated by EAS prebuild from app.json
android/
ios/

# Backend / admin sub-projects (not part of the mobile app)
server/
super_admin/

# Large binaries & docs (the 127MB preview APK lives here)
*.apk
*.aab
*.pdf
*.mp4

# Scratch reports
*.md
SHIFT_REPORT*
daily-report*

# Credentials — must never be uploaded
play-service-account.json
asc-api-key.p8
*.p8
*.p12
*.jks
*.keystore
credentials.json

# Local env files. EAS builds and `eas update` take EXPO_PUBLIC_* from the EAS
# environment named by the build profile (eas.json → "environment"), so a build
# must never see a developer's localhost/test values: uploading .env would let
# any variable missing from the EAS environment silently fall through to the
# local one — which is how a dev API URL reaches a store binary.
.env
.env.*
